# Copy to .env and fill in. In production, BIND_ADDRESS should be your
# Tailscale interface IP (or MagicDNS-resolved address), never 0.0.0.0.

BIND_ADDRESS=127.0.0.1
PORT=4317
NODE_ENV=development

# Root directory under which every managed project lives, e.g. /home/user/apps
APPS_ROOT=./server/data/apps-root

# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

ADMIN_USERNAME=admin
# Generate with: npm run set-password -w server -- <your-password>
ADMIN_PASSWORD_HASH=

# Set to true once served over HTTPS (e.g. via `tailscale cert`)
COOKIE_SECURE=false

# Command spawned in each project's terminal panel. Defaults to the real Claude
# Code CLI. Override to "bash" for local/sandbox testing without a claude login.
CLAUDE_COMMAND=claude

# Only relevant outside production: the origin the Vite dev server runs on,
# since it proxies /api and /ws to this backend from a different port.
DEV_FRONTEND_ORIGIN=http://localhost:5173

# --- Nightly security scan (docs/DEPLOYMENT.md section 7) ---
# Only used by the separate overlay-security-scan systemd service, not by
# the main web server process. Defaults are sensible; usually no need to
# change these unless clamscan should target something other than "/".
FULL_SYSTEM_SCAN_PATH=/
LYNIS_REPORT_PATH=/var/log/lynis-report.dat
# Comma-separated hosts allowed to have listening sockets, besides loopback.
# Empty = just BIND_ADDRESS.
SECURITY_SCAN_ALLOWED_HOSTS=
# Read directly by security/cli.ts (not schema-validated, both optional): the
# unprivileged user/group that runs the main Overlay server, so the
# root-run scan can chown its reports to be readable by it afterwards.
SECURITY_SCAN_CHOWN_USER=
SECURITY_SCAN_CHOWN_GROUP=

# Optional advisory-only LLM triage of the scan findings, via a local Ollama
# instance already running on the server. Leave OLLAMA_MODEL empty (default)
# to skip this step entirely — it never affects severities/counts either way.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=600000

# Optional push notification (via ntfy.sh or self-hosted ntfy) when the
# nightly scan finds anything critical/high. Empty = disabled. If using the
# public ntfy.sh, use a long random topic name — see docs/DEPLOYMENT.md
# section 7.4 for why (topics are effectively public-by-obscurity).
NTFY_URL=

# --- Nightly backups via restic (docs/DEPLOYMENT.md section 8) ---
# Only used by the separate overlay-backup systemd service. Empty
# RESTIC_REPOSITORY disables backups entirely — unlike the security scan,
# this runs as the SAME unprivileged user as the main Overlay process.
# Repository can be a local path, or any restic backend URL (SFTP, S3,
# Backblaze B2, etc.) — see https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html
RESTIC_REPOSITORY=
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# Store this somewhere safe OUTSIDE the server being backed up — losing it
# means losing access to every snapshot, even if the repository itself
# survives.
RESTIC_PASSWORD=
BACKUP_TIMEOUT_MS=3600000
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Timeout for the per-project "Deploy" button (POST /api/projects/:id/deploy),
# which runs a project's optional deployScript (e.g. "git pull && npm install
# && npm run build") as a shell command. Generous default since a real build
# step can take a while.
DEPLOY_TIMEOUT_MS=600000

# Timeout for a single "Ideen"-chat turn (headless `claude -p` call).
IDEA_CHAT_TIMEOUT_MS=300000

# --- Optional local Ollama pre-filter for the "Ideen"-chat (docs/DEPLOYMENT.md section 9) ---
# Every idea-chat message is tried against these local models first (RAM
# tier, then GPU tier) before ever reaching Claude; each tier's own model
# decides whether it can answer or the request needs actual code access, in
# which case it escalates. Meant for two separate local Ollama instances —
# start each with a different OLLAMA_HOST port. Leave a *_MODEL empty
# (default) to skip that tier; leave both empty to skip local pre-filtering
# entirely and go straight to Claude, same as before this feature existed.
IDEA_CHAT_OLLAMA_RAM_URL=http://127.0.0.1:11434
IDEA_CHAT_OLLAMA_RAM_MODEL=
IDEA_CHAT_OLLAMA_GPU_URL=http://127.0.0.1:11435
IDEA_CHAT_OLLAMA_GPU_MODEL=
IDEA_CHAT_OLLAMA_TIMEOUT_MS=120000
