# Copy to .env and fill in. In production, BIND_ADDRESS should be your
# Tailscale interface IP (or MagicDNS-resolved address), never 0.0.0.0.

BIND_ADDRESS=127.0.0.1
PORT=4317
NODE_ENV=development

# Root directory under which every managed project lives, e.g. /home/user/apps
APPS_ROOT=./server/data/apps-root

# Overlay has no login of its own — every route trusts the Remote-User header
# Caddy's forward_auth sets once Authelia approves a two_factor session (the
# required setup, Abschnitt 9 in docs/DEPLOYMENT.md). Setting this to true
# skips that header check entirely (requireAuth, the WebSocket upgrade check
# and /api/session all become no-ops) — ONLY defensible for local dev, when
# no Authelia/Caddy sits in front at all. With Overlay reachable directly,
# this publishes the dashboard, every project terminal and this machine's
# .env to anyone who can reach the port, with zero authentication. Leave
# empty for normal behaviour, which every fresh install gets.
AUTH_DISABLED=

# Command spawned in each project's terminal panel. Defaults to the real Claude
# Code CLI. Override to "bash" for local/sandbox testing without a claude login.
CLAUDE_COMMAND=claude

# Runs every project terminal inside a bubblewrap (bwrap) sandbox that can only
# see that project — without it, a session opened for one project can read
# every other project and this installation's own .env. On by default;
# requires `apt install bubblewrap`. Set to false only if bwrap cannot be
# installed, which runs the terminal with the full rights of the service user.
TERMINAL_SANDBOX=true

# A fine-grained GitHub PAT (scope it to just "Contents: Read and write" on
# the repos Overlay should be able to push to) that every sandboxed project
# session can use to `git push` its own branches, so a prepared commit no
# longer needs a manual `git push` from outside the sandbox. Shared across
# every project on this installation — same trust model as the Claude login
# above — so keep it scoped to only the repos this instance is trusted to
# modify. Leave empty to keep today's behaviour: sessions can prepare
# commits, but pushing still needs a manual step from outside any sandbox.
GIT_SANDBOX_PUSH_TOKEN=

# Only relevant outside production: the origin the Vite dev server runs on,
# since it proxies /api and /ws to this backend from a different port.
DEV_FRONTEND_ORIGIN=http://localhost:5173

# --- Nightly security scan (docs/DEPLOYMENT.md section 7) ---
# Only used by the separate overlay-security-scan systemd service, not by
# the main web server process. Defaults are sensible; usually no need to
# change these unless clamscan should target something other than "/".
FULL_SYSTEM_SCAN_PATH=/
LYNIS_REPORT_PATH=/var/log/lynis-report.dat
# Comma-separated hosts allowed to have listening sockets, besides loopback.
# Empty = just BIND_ADDRESS.
SECURITY_SCAN_ALLOWED_HOSTS=
# Read directly by security/cli.ts (not schema-validated, both optional): the
# unprivileged user/group that runs the main Overlay server, so the
# root-run scan can chown its reports to be readable by it afterwards.
SECURITY_SCAN_CHOWN_USER=
SECURITY_SCAN_CHOWN_GROUP=

# Optional advisory-only LLM triage of the scan findings, via a local Ollama
# instance already running on the server. Leave OLLAMA_MODEL empty (default)
# to skip this step entirely — it never affects severities/counts either way.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=600000

# Optional push notification (via ntfy.sh or self-hosted ntfy) when the
# nightly scan finds anything critical/high. Empty = disabled. If using the
# public ntfy.sh, use a long random topic name — see docs/DEPLOYMENT.md
# section 7.4 for why (topics are effectively public-by-obscurity).
NTFY_URL=

# --- Nightly backups via restic (docs/DEPLOYMENT.md section 8) ---
# Only used by the separate overlay-backup systemd service. Empty
# RESTIC_REPOSITORY disables backups entirely — unlike the security scan,
# this runs as the SAME unprivileged user as the main Overlay process.
# Repository can be a local path, or any restic backend URL (SFTP, S3,
# Backblaze B2, etc.) — see https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html
RESTIC_REPOSITORY=
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
# Store this somewhere safe OUTSIDE the server being backed up — losing it
# means losing access to every snapshot, even if the repository itself
# survives.
RESTIC_PASSWORD=
BACKUP_TIMEOUT_MS=3600000
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Timeout for the per-project "Deploy" button (POST /api/projects/:id/deploy),
# which runs a project's optional deployScript (e.g. "git pull && npm install
# && npm run build") as a shell command. Generous default since a real build
# step can take a while.
DEPLOY_TIMEOUT_MS=600000

# Timeout for a single "Ideen"-chat turn (headless `claude -p` call).
IDEA_CHAT_TIMEOUT_MS=300000

# --- Optional local Ollama pre-filter for the "Ideen"-chat (docs/DEPLOYMENT.md section 9) ---
# Every idea-chat message is tried against these local models first (RAM
# tier, then GPU tier) before ever reaching Claude; each tier's own model
# decides whether it can answer or the request needs actual code access, in
# which case it escalates. Meant for two separate local Ollama instances —
# start each with a different OLLAMA_HOST port. Leave a *_MODEL empty
# (default) to skip that tier; leave both empty to skip local pre-filtering
# entirely and go straight to Claude, same as before this feature existed.
IDEA_CHAT_OLLAMA_RAM_URL=http://127.0.0.1:11434
IDEA_CHAT_OLLAMA_RAM_MODEL=
IDEA_CHAT_OLLAMA_GPU_URL=http://127.0.0.1:11435
IDEA_CHAT_OLLAMA_GPU_MODEL=
IDEA_CHAT_OLLAMA_TIMEOUT_MS=120000

# --- Optional outgoing webhook to a self-hosted OpenClaw gateway (https://openclaw.ai/) ---
# Sends a simple {"text": "..."} POST to OPENCLAW_WEBHOOK_URL on critical
# scan findings, backup failures and saved Ideenpläne — in addition to
# ntfy above, not instead of it. Empty URL disables this entirely. NOTE:
# OpenClaw's exact payload/auth expectations weren't verified against its
# primary docs — see server/src/openclaw/openclaw-webhook.ts, adjust if
# your instance expects something different.
OPENCLAW_WEBHOOK_URL=
OPENCLAW_WEBHOOK_SECRET=

# --- Emmy-Chat: inbound endpoint for OpenClaw to deliver the agent's replies ---
# Bearer token for POST /api/emmy/inbound (see docs/DEPLOYMENT.md §14.3).
# Empty = that endpoint 404s. Separate from OPENCLAW_WEBHOOK_SECRET above,
# which authenticates outbound requests in the other direction.
EMMY_INBOUND_TOKEN=

# --- Emmy multi-chat: OpenClaw Gateway hooks endpoint ---
# The multi-chat app drives one isolated agent turn per chat message, bound to
# a per-chat sessionKey, via the Gateway's POST /hooks/agent endpoint. This is
# separate from OPENCLAW_WEBHOOK_URL above (the legacy webhook-plugin path,
# which has no per-chat sessions). OPENCLAW_HOOK_TOKEN is the Gateway's
# hooks.token. Empty = sending a chat message fails with a clear "nicht
# konfiguriert" error, but the message stays saved.
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=

# --- Emmy multi-chat: cross-conversation memory (optional, local Ollama) ---
# Every message, in every chat — including deleted ones — is embedded via a
# local Ollama model and cosine-matched against new messages, so Emmy can
# recall something discussed in a different (or deleted) chat without it
# being repasted. Empty EMMY_MEMORY_EMBEDDING_MODEL disables this tier
# entirely (no network call is attempted); Emmy still keeps the current
# chat's own recent history either way. Suggested model: "bge-m3"
# (multilingual — Emmy's own prompts are German). EMMY_MEMORY_VISION_MODEL is
# an extra, separately optional step: a short caption (e.g. via "llava") for
# image attachments, folded into what gets indexed, so a photo is findable by
# what's in it, not just its filename.
EMMY_MEMORY_OLLAMA_URL=http://127.0.0.1:11434
EMMY_MEMORY_EMBEDDING_MODEL=
EMMY_MEMORY_VISION_MODEL=
EMMY_MEMORY_EMBEDDING_TIMEOUT_MS=15000
EMMY_MEMORY_VISION_TIMEOUT_MS=60000
EMMY_MEMORY_TOP_K=6
EMMY_MEMORY_MIN_SCORE=0.55
EMMY_MEMORY_RECENT_MESSAGES=10
